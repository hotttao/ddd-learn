		"js-yaml": "^4.1.0",
		"lucide-react": "^0.487.0",
		"react": "^18.0.0",
		"react-dom": "^18.0.0",
		"react-hook-form": "^7.54.2",
		"react-i18next": "^15.4.1",
		"react-router": "^7.5.3",
		"react-router-dom": "^7.5.3",
		"sonner": "^2.0.2",
		"tailwind-merge": "^3.0.1",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.7",
		"@playwright/test": "^1.58.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.13.4",
		"@types/react": "^18.0.0",
		"@types/react-dom": "^18.0.0",
		"@vitejs/plugin-react": "^4.0.0",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "^4.0.8",
		"autoprefixer": "^10.4.20",
		"dependency-cruiser": "^17.3.8",
		"husky": "^9.1.7",
		"jscpd": "^4.0.8",
		"jsdom": "^27.2.0",
		"knip": "^5.85.0",
		"lint-staged": "^16.1.2",
		"postcss": "^8.5.3",
		"rollup-plugin-visualizer": "^7.0.0",
		"tailwindcss": "^3",
		"typescript": "^5.4.2",
		"vite": "^6.0.0",
		"vitest": "^4.0.8"
	},
	"scripts": {
		"prepare": "husky",
		"predev": "node scripts/check-node-version.mjs",
		"dev": "vite",
		"prebuild": "node scripts/check-node-version.mjs",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"dep-check": "depcruise src --config .dependency-cruiser.cjs",
		"knip": "knip",
		"cpd": "jscpd src",
		"i18n:scan": "node tools/i18n-tracker.cjs",
		"i18n:update": "node tools/i18n-tracker.cjs update",
		"i18n:update-all": "node tools/i18n-tracker.cjs update-all",
		"i18n:check-keys": "node tools/check-i18n-keys.cjs"
	},
	"browserslist": {
		"production": [
			">0.2%",
			"not dead",
			"not op_mini all"
		],
		"development": [
			"last 1 chrome version",
			"last 1 firefox version",
			"last 1 safari version"
		]
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json,jsonc}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"packageManager": "yarn@1.22.22"
}
